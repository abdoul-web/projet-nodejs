<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Résultats des Modèles</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f8f9fa;
            margin: 0;
            padding: 0;
        }

        nav {
            background-color: #1f2937;
            padding: 10px;
            display: flex;
            justify-content: space-between;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 15px;
            font-size: 1.1rem;
            transition: color 0.3s ease;
        }

        nav a:hover {
            color: #00d4ff;
        }

        header {
            text-align: center;
            padding: 20px 0;
            background-color: #0d6efd;
            color: white;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        }

        main {
            padding: 30px;
        }

        .image-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 20px;
            padding: 20px;
        }

        .image-container div {
            background-color: white;
            border-radius: 12px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            text-align: center;
            padding: 20px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            cursor: pointer;
        }

        .image-container div:hover {
            transform: translateY(-5px);
            box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.2);
        }

        .image-container h2 {
            font-size: 1.5rem;
            margin-bottom: 15px;
            color: #0d6efd;
        }

        .image-container img {
            width: 100%;
            max-width: 100%;
            height: auto;
            border-radius: 8px;
        }

        footer {
            text-align: center;
            padding: 15px 0;
            background-color: #1f2937;
            color: white;
        }

        .no-images {
            text-align: center;
            font-size: 1.2rem;
            color: #6c757d;
            padding: 20px;
        }

        /* Fullscreen Modal */
        .fullscreen-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .fullscreen-modal img {
            max-width: 90%;
            max-height: 90%;
            border-radius: 12px;
        }

        .fullscreen-modal:target {
            display: flex;
        }

        .close-btn {
            position: absolute;
            top: 20px;
            right: 30px;
            color: white;
            font-size: 2rem;
            text-decoration: none;
            font-weight: bold;
            transition: color 0.3s ease;
        }

        .close-btn:hover {
            color: #f00;
        }
    </style>
</head>
<body>
    <nav>
        <a href="/"><i class="fas fa-home"></i> Accueil</a>
        <a href="/patients"><i class="fas fa-users"></i> Patients</a>
        <a href="/results"><i class="fas fa-chart-bar"></i> Résultats</a>
    </nav>
    <header>
        <h1>Résultats des Modèles de Machine Learning</h1>
    </header>
    <main>
        <% if (images.length > 0) { %>
        <div class="image-container">
            <% images.forEach(image => { %>
                <div>
                    <h2><i class="fas fa-chart-line"></i> <%= image.replace('_results.png', '') %></h2>
                    <a href="#modal-<%= image %>">
                        <img src="/results/<%= image %>" alt="<%= image %>">
                    </a>
                </div>
                <div id="modal-<%= image %>" class="fullscreen-modal">
                    <a href="#" class="close-btn">&times;</a>
                    <img src="/results/<%= image %>" alt="<%= image %>">
                </div>
            <% }) %>
        </div>
        <% } else { %>
        <p class="no-images"><i class="fas fa-exclamation-circle"></i> Aucun graphique trouvé. Assurez-vous que les modèles ont été exécutés.</p>
        <% } %>
    </main>
    <footer>
        <p>&copy; 2024 Medical Data. Tous droits réservés.</p>
    </footer>
</body>
</html>
